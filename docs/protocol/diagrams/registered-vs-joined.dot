/* The two words the protocol keeps strictly apart. Rendered to ../img/registered-vs-joined.svg */
digraph registered_vs_joined {
  bgcolor="transparent";
  rankdir=TB;
  fontname="Helvetica"; fontcolor="#888888";
  node [fontname="Helvetica", fontsize=10, style="filled", color="#00000000", fontcolor="#1a1a1a", shape=box];
  edge [fontname="Helvetica", fontsize=9, color="#888888", fontcolor="#888888"];

  outside [label="outside the arena\nin neither list", fillcolor="#e6e6e6"];

  subgraph cluster_arena {
    label="  REGISTERED — in the arena  "; style="rounded,dashed"; color="#888888"; fontsize=10;
    labeljust="l";

    waiting [label="registered, not yet seated\n\nstate.registered  ✓\nstate.players  ✗", fillcolor="#f7e3c0"];

    subgraph cluster_match {
      label="  JOINED — seated for THIS match  "; style="rounded"; color="#bbbbbb"; fontsize=10;
      seated [label="on the board\n\nstate.registered  ✓\nstate.players  ✓", fillcolor="#d8ecd8"];
    }
  }

  leaving [label="left mid-match — plays this match out\n\nstate.registered  ✗\nstate.players  ✓", fillcolor="#f6cfcf"];

  outside -> waiting [label="  POST /api/players\l  → player_registered\l"];
  waiting -> seated  [label="  the next match starts\l  → player_joined\l"];
  seated  -> waiting [label="  match ends\l  (re-seated next match)\l", constraint=false];
  seated  -> leaving [label="  DELETE /api/players/{name}\l  → player_unregistered\l"];
  leaving -> outside [label="  match ends\l"];
  waiting -> outside [label="  DELETE /api/players/{name}\l  → player_unregistered\l", constraint=false];
}
