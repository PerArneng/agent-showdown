/* How one thing that happens in a match reaches three different places.
   Rendered to ../img/observation.svg */
digraph observation {
  bgcolor="transparent";
  rankdir=LR;
  fontname="Helvetica"; fontcolor="#888888";
  node [fontname="Helvetica", fontsize=10, style="filled", color="#00000000", fontcolor="#1a1a1a", shape=box];
  edge [fontname="Helvetica", fontsize=9, color="#888888", fontcolor="#888888"];

  game [label="Game\n( and the Engine, for the\narena and roster callbacks )", fillcolor="#d8ecd8"];
  gl   [label="GameListener\n19 callbacks\nfanned out in registration order", fillcolor="#f7e3c0"];

  log  [label="LogGameListener\n→ Logger → Console\none INFO line each\n(turn_failed is WARNING)", fillcolor="#e6e6e6"];
  chan [label="ChannelGameListener\nthe ONLY translator from\ncallback to event model", fillcolor="#cfe3f7"];
  snap [label="SnapshotGameListener\nkeeps a frozen GameSnapshot,\nreplaced never mutated", fillcolor="#cfe3f7"];
  rec  [label="RecordingGameListener\ntests/fakes — records\n(name, args) tuples", fillcolor="#e6e6e6"];

  ev   [label="19 event models\ntold apart by a Literal `type`,\ncollected in the GameEvent union", fillcolor="#d8ecd8"];
  ch   [label="EventChannel\nfan-out queue", fillcolor="#d8ecd8"];
  sse  [label="GET /api/events\nSSE", fillcolor="#d8ecd8"];
  st   [label="GET /api/state\nGameSnapshot + PlayerSnapshot", fillcolor="#cfe3f7"];

  game -> gl;
  gl -> log; gl -> chan; gl -> snap; gl -> rec;
  chan -> ev -> ch -> sse;
  snap -> st;

  rule [shape=note, fillcolor="#e6e6e6", fontsize=9,
        label="Adding a GameListener method means adding\nits event model, its union entry, all four\nimplementations, and the TypeScript mirror.\nMiss one and the two projects drift."];
  gl -> rule [style=dashed, arrowhead=none];
}
